# Copy to .env.local for local dev. Never commit .env.local.
# On Vercel, add the same variables in Project Settings -> Environment Variables.

# Public site URL, no trailing slash. Used for metadata, sitemap.xml and robots.txt.
# Local: http://localhost:3000 | Now: https://fazaasec.vercel.app | Later: https://fazaasec.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). SERVER-ONLY: used by the Server Action, never shipped to the browser.
# Use the anon (public) key. Do NOT use the service_role key anywhere in this project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile).
# The values below are Cloudflare's official always-pass TEST keys for local dev. Replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random string used to hash visitor IPs before storing (for rate limiting). Generate with: openssl rand -hex 32
IP_HASH_SALT=
